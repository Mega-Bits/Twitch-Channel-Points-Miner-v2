+    def _select_streamers_to_watch(self, streamers, priority, max_watch_amount=2):
+        """Select one drop channel first, then fill remaining slots by priority."""
+        online_indexes = [
+            index
+            for index, streamer in enumerate(streamers)
+            if streamer.is_online is True
+            and (
+                streamer.online_at == 0
+                or (time.time() - streamer.online_at) > 30
+            )
+        ]
+        main_indexes = [
+            index
+            for index in online_indexes
+            if streamers[index].source != "drop_fallback"
+        ]
+        fallback_indexes = [
+            index
+            for index in online_indexes
+            if streamers[index].source == "drop_fallback"
+        ]
+        selected = []
+
+        def remaining_watch_amount():
+            return max_watch_amount - len(selected)
+
+        def add(index):
+            if remaining_watch_amount() > 0 and index not in selected:
+                selected.append(index)
+
+        def watch_streak_condition(index):
+            streamer = streamers[index]
+            return (
+                streamer.settings.watch_streak is True
+                and streamer.stream.watch_streak_missing is True
+                and (
+                    streamer.offline_at == 0
+                    or ((time.time() - streamer.offline_at) // 60) > 30
+                )
+                and streamer.stream.minute_watched < 7
+            )
+
+        def eligible_for_campaign(index, campaign_id):
+            streamer = streamers[index]
