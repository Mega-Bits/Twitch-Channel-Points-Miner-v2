+
+        def lock_campaign(campaign_id):
+            if campaign_id is None:
+                return
+            if self.locked_drop_campaign_id != campaign_id:
+                logger.info(
+                    f"Prioritizing unfinished drop campaign {campaign_id}",
+                    extra={"emoji": ":package:", "event": Events.DROP_STATUS},
+                )
+            self.locked_drop_campaign_id = campaign_id
+
+        active_campaign_ids = self.active_drop_campaign_ids
+        locked_campaign_id = self.locked_drop_campaign_id
+        if (
+            locked_campaign_id is not None
+            and locked_campaign_id not in active_campaign_ids
+        ):
+            self.locked_drop_campaign_id = None
+            locked_campaign_id = None
+
+        # Keep farming the selected in-progress campaign until inventory says it is complete.
+        if locked_campaign_id is not None:
+            locked_candidates = [
+                index
+                for index in main_indexes + fallback_indexes
+                if eligible_for_campaign(index, locked_campaign_id)
+            ]
+            if locked_candidates:
+                add(locked_candidates[0])
+
+        # With no campaign lock, prefer a drop-enabled channel from the user's list.
+        if locked_campaign_id is None:
+            main_drop_index = next(
+                (index for index in main_indexes if has_unfinished_drop(index)),
+                None,
+            )
+            if main_drop_index is not None:
+                add(main_drop_index)
+                campaign_ids = active_campaign_ids.intersection(
+                    streamers[main_drop_index].stream.campaigns_ids
+                )
+                if campaign_ids:
+                    lock_campaign(
+                        max(
+                            campaign_ids,
+                            key=lambda campaign_id: self.drop_campaign_progress.get(
+                                campaign_id, 0
+                            ),
+                        )
+                    )
+            else:
+                # No suitable main-list channel: lock the most progressed campaign
+                # for which we have explicit allow.channels fallback entries.
+                ordered_campaign_ids = sorted(
+                    active_campaign_ids,
+                    key=lambda campaign_id: self.drop_campaign_progress.get(
+                        campaign_id, 0
+                    ),
+                    reverse=True,
+                )
+                for campaign_id in ordered_campaign_ids:
+                    known_fallback = any(
+                        streamer.source == "drop_fallback"
+                        and campaign_id in streamer.fallback_campaign_ids
+                        for streamer in streamers
+                    )
+                    if not known_fallback:
+                        continue
+                    lock_campaign(campaign_id)
+                    locked_candidates = [
+                        index
+                        for index in main_indexes + fallback_indexes
+                        if eligible_for_campaign(index, campaign_id)
+                    ]
+                    if locked_candidates:
+                        add(locked_candidates[0])
+                    break
+
+        # A Drop can progress on only one channel at a time. Remaining capacity is
+        # reserved for the user's normal priority list, including later watch streaks.
+        for prior in priority:
+            if remaining_watch_amount() <= 0:
+                break
+            if prior == Priority.DROPS:
+                continue
+            if prior == Priority.ORDER:
+                for index in main_indexes:
+                    add(index)
+                    if remaining_watch_amount() <= 0:
+                        break
+            elif prior in [Priority.POINTS_ASCENDING, Priority.POINTS_DESCENDING]:
+                ordered = sorted(
+                    main_indexes,
+                    key=lambda index: streamers[index].channel_points,
+                    reverse=prior == Priority.POINTS_DESCENDING,
+                )
+                for index in ordered:
+                    add(index)
+                    if remaining_watch_amount() <= 0:
+                        break
+            elif prior == Priority.STREAK:
+                for index in main_indexes:
+                    if watch_streak_condition(index):
+                        add(index)
+                    if remaining_watch_amount() <= 0:
+                        break
+            elif prior == Priority.SUBSCRIBED:
+                ordered = sorted(
+                    [
+                        index
+                        for index in main_indexes
+                        if streamers[index].viewer_has_points_multiplier()
+                    ],
+                    key=lambda index: streamers[index].total_points_multiplier(),
+                    reverse=True,
+                )
+                for index in ordered:
+                    add(index)
+                    if remaining_watch_amount() <= 0:
+                        break
+
+        return selected[:max_watch_amount]
